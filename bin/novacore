#!/usr/bin/env bash
#
# novacore — manage local PHP sites on a Dockerised LEMP stack.
# Run `novacore help` for usage.

set -euo pipefail
# Bash 5.2+ treats & in a ${var//pattern/replacement} as the matched text; we
# want it literal.
shopt -u patsub_replacement 2>/dev/null || true

NOVACORE_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
cd "$NOVACORE_ROOT"

SUPPORTED_PHP=(7.4 8.0 8.1 8.2 8.3 8.4 8.5)
SITES_CONF="$NOVACORE_ROOT/sites.conf"
DATA_DIR="$NOVACORE_ROOT/data"
LOGS_DIR="$NOVACORE_ROOT/logs"

# --- Output ------------------------------------------------------------------
#
# The same look as Ignition and WP-CLI Sync: a banner, a heading per task with
# its outcome and time, and a summary line at the end. Command output is held
# back: its latest line shows while it runs, and the rest only if it fails.
# Commands that just report something skip the banner, so they stay terse.

IS_TTY=0
if [[ -t 1 ]]; then IS_TTY=1; fi
RUN_START=''
TASK_START=''
TERM_COLS=''

# color TEXT SGR — wrap text in an ANSI colour, e.g. 32 or '1;34'.
color() {
    if (( IS_TTY )); then printf '\e[%sm%s\e[0m' "$2" "$1"; else printf '%s' "$1"; fi
}

# Clear the current line, ready to redraw it.
clear_line() {
    if (( IS_TTY )); then printf '\r\e[2K'; fi
}

# Milliseconds since the epoch. Whole seconds on Bash before 5.0 (macOS).
now_ms() {
    if [[ -n ${EPOCHREALTIME:-} ]]; then
        local us=${EPOCHREALTIME//[.,]/}
        echo $(( us / 1000 ))
    else
        echo $(( $(date +%s) * 1000 ))
    fi
}

# elapsed START_MS — the time since START_MS as a short label, e.g. 4.2s or 1m 3s.
elapsed() {
    local ms=$(( $(now_ms) - $1 ))
    if (( ms < 60000 )); then
        printf '%d.%ds' $(( ms / 1000 )) $(( ms % 1000 / 100 ))
    else
        printf '%dm %ds' $(( ms / 60000 )) $(( (ms % 60000 + 500) / 1000 ))
    fi
}

# count N SINGULAR PLURAL — e.g. "1 site" or "3 sites".
count() { if (( $1 == 1 )); then echo "1 $2"; else echo "$1 $3"; fi; }

# join SEPARATOR ITEM...
join() {
    local sep=$1 out item
    shift
    (( $# )) || return 0
    out=$1
    shift
    for item in "$@"; do out+=$sep$item; done
    printf '%s' "$out"
}

# The git tag this checkout is on, or "dev".
version() {
    local tag
    tag=$(git -C "$NOVACORE_ROOT" describe --tags 2>/dev/null) || { echo dev; return; }
    echo "v$tag"
}

# header PART... — the banner at the start of a command, e.g. "Starting".
header() {
    RUN_START=$(now_ms)
    # Novacore's own colour (#17D4A4, the dashboard's teal) where the terminal
    # supports it, cyan elsewhere.
    local brand='1;36'
    case ${COLORTERM:-} in truecolor|24bit) brand='1;38;2;23;212;164' ;; esac
    printf '\n%s  %s\n' "$(color '○ Novacore' "$brand")" "$(join "$(color ' · ' 90)" "$@" "$(color "$(version)" 90)")"
}

# heading NAME — a task heading. Starts the task's timer.
heading() {
    TASK_START=$(now_ms)
    printf '\n%s\n' "$(color "› $1" '1;34')"
}

# result MESSAGE [success|warning|error] — a task's outcome, with its time.
result() {
    local symbol=✔ c=32 time=''
    case ${2:-success} in
        warning) symbol=! c=33 ;;
        error)   symbol=✖ c=31 ;;
    esac
    [[ -z $TASK_START ]] || time=" $(color "($(elapsed "$TASK_START"))" 90)"
    clear_line
    printf '  %s%s\n' "$(color "$symbol $1" "$c")" "$time"
}

# note TEXT [SGR] — an indented line, gray unless given a colour.
note() { printf '  %s\n' "$(color "$1" "${2:-90}")"; }

# A warning within a task.
warn() {
    clear_line
    note "! $*" 33
}

# message TITLE MESSAGE [COLOR] — a standalone note.
message() { printf '  %s%s\n' "$(color "$1: " "${3:-90}")" "$2"; }

hint() { message Hint "$1" 33; }

# detail LABEL VALUE — one line of a summary, e.g. a site's URL.
detail() { printf '  %s%s\n' "$(color "$(printf '%-16s' "$1")" 90)" "$2"; }

# complete MESSAGE — the closing line, with the time since the banner.
complete() { printf '\n%s\n' "$(color "✔ $1 in $(elapsed "$RUN_START")" '1;32')"; }

# fail MESSAGE [HINT] — end the command with an error, and a hint on fixing it.
fail() {
    clear_line
    {
        printf '\n%s\n' "$(color "✖ $1" '1;31')"
        [[ -z ${2:-} ]] || hint "$2"
        echo
    } >&2
    exit 1
}

# Redraw a single gray status line, trimmed to the terminal width.
status_line() {
    (( IS_TTY )) || return 0
    if [[ -z $TERM_COLS ]]; then
        # Read with stty, from the terminal itself; tput says 80 when piped.
        TERM_COLS=$(stty size </dev/tty 2>/dev/null | awk '{ print $2 }') || true
        [[ $TERM_COLS =~ ^[1-9][0-9]*$ ]] || TERM_COLS=80
    fi
    local text=$1
    (( ${#text} < TERM_COLS )) || text="${text:0:TERM_COLS-2}…"
    clear_line
    color "$text" 90
}

# block FILE — the last lines of a command's output, e.g. after it failed.
block() {
    local max=15 total line
    total=$(grep -c . "$1") || true
    if (( total > max )); then
        printf '    %s\n' "$(color "… $(( total - max )) earlier lines" 90)"
    fi
    grep . "$1" | tail -n "$max" | while IFS= read -r line; do
        printf '    %s\n' "$(color "${line//$'\r'/}" 90)"
    done || true
}

# run COMMAND... — run a command with its output held back. Its latest line is
# the status line, and if it fails, its last lines show under the task.
run() {
    local log status line
    log=$(mktemp)
    set +e
    "$@" 2>&1 | tee "$log" | while IFS= read -r line; do
        line=${line//$'\r'/}
        status_line "    ${line#"${line%%[![:space:]]*}"}"
    done
    status=${PIPESTATUS[0]}
    set -e
    if (( status )); then
        result "Failed with exit code $status" error
        block "$log"
    fi
    clear_line
    rm -f "$log"
    return "$status"
}

compose() { docker compose "$@"; }

# has_line LINES LINE — whether LINE is one of LINES.
has_line() { [[ $'\n'$1$'\n' == *$'\n'$2$'\n'* ]]; }

# services [DOCKER PS OPTION...] — the services with a running container, one
# per line, or with -a, with any container. This asks Docker rather than
# Compose, which takes three times as long to read its files and answer.
services() {
    docker ps "$@" --filter label=com.docker.compose.project=novacore \
        --format '{{.Label "com.docker.compose.service"}}'
}

# Fail early with a useful message when Docker isn't usable.
check_docker() {
    command -v docker >/dev/null || fail "Docker isn't installed" "See https://docs.docker.com/engine/install/"
    docker version --format '{{.Server.Version}}' >/dev/null 2>&1 && return

    local sock=/var/run/docker.sock user
    user=$(id -un)
    if [[ -S $sock && ! -w $sock ]]; then
        if id -nG "$user" | grep -qw docker; then
            fail "This session started before you joined the docker group" "Log out and back in (or reboot), then try again"
        fi
        fail "Your user can't use Docker" "Run sudo usermod -aG docker $user, then log out and back in"
    fi
    if [[ $(uname) == Darwin ]]; then
        fail "Can't reach the Docker daemon" "Is Docker Desktop or OrbStack running?"
    fi
    fail "Can't reach the Docker daemon" "Is it running? Try sudo systemctl start docker"
}

# --- Environment -------------------------------------------------------------

# rewrite FILE AWK-ARGUMENT... — pass FILE through awk, in place. The file is
# written over rather than replaced, so it keeps its owner, mode and links.
rewrite() {
    local file=$1 tmp
    shift
    tmp=$(mktemp)
    awk "$@" "$file" > "$tmp"
    cat "$tmp" > "$file"
    rm -f "$tmp"
}

# env_set KEY VALUE — update KEY in .env, appending it if missing.
env_set() {
    rewrite .env -v k="$1" -v v="$2" '
        index($0, k "=") == 1 { print k "=" v; found = 1; next }
        { print }
        END { if (!found) print k "=" v }'
    export "$1=$2"
}

load_env() {
    if [[ ! -f .env ]]; then
        cp .env.example .env
        env_set NOVACORE_UID "$(id -u)"
        env_set NOVACORE_GID "$(id -g)"
        message Note "Created .env. Edit it to change the ports, the default PHP and more."
    fi
    set -a
    # shellcheck source=/dev/null
    source .env
    set +a

    NOVACORE_TLD=${NOVACORE_TLD:-localhost}
    DEFAULT_PHP=${DEFAULT_PHP:-8.4}
    SITES_DIR=${SITES_DIR:-./sites}
    XDEBUG_MODE=${XDEBUG_MODE:-develop,debug}
    DB_ROOT_PASSWORD=${DB_ROOT_PASSWORD:-root}
    DB_USER=${DB_USER:-novacore}
    DB_PASSWORD=${DB_PASSWORD:-novacore}
    DB_PORT=${DB_PORT:-3306}
    # What DB_HOST is outside Novacore: MariaDB's published port.
    HOST_DB_HOST=127.0.0.1
    [[ $DB_PORT == 3306 ]] || HOST_DB_HOST+=":$DB_PORT"

    case $SITES_DIR in
        /*) SITES_PATH=$SITES_DIR ;;
        *)  SITES_PATH="$NOVACORE_ROOT/${SITES_DIR#./}" ;;
    esac

    # The generated overrides are part of the project, and every PHP service
    # sits behind the "php" profile so `down`/`ps`/`logs` see them all.
    export COMPOSE_FILE="docker-compose.yml:data/compose.generated.yml"
    export COMPOSE_PROFILES=php

    [[ -d $DATA_DIR/certs && -d $DATA_DIR/nginx/sites && -d $DATA_DIR/nginx/www && -d $LOGS_DIR ]] ||
        mkdir -p "$DATA_DIR/certs" "$DATA_DIR/nginx/sites" "$DATA_DIR/nginx/www" "$LOGS_DIR"
    load_sites
    [[ -f $DATA_DIR/compose.generated.yml ]] || write_overrides
}

# --- Sites -------------------------------------------------------------------

# Read sites.conf into arrays with an entry per site: SITE_NAMES, SITE_PHP (its
# PHP version), SITE_ROOT (its document root, relative to its folder),
# SITE_ROOT_CONF (the root as sites.conf has it, where "-" auto-detects),
# SITE_DOMAIN and SITE_DB (its database). They're read once, rather than each
# time something asks about a site, so run this again after changing
# sites.conf or DEFAULT_PHP.
load_sites() {
    SITE_NAMES=() SITE_PHP=() SITE_ROOT=() SITE_ROOT_CONF=() SITE_DOMAIN=() SITE_DB=()
    [[ -f $SITES_CONF ]] || return 0
    local line name php conf root d rest
    while IFS= read -r line || [[ -n $line ]]; do
        read -r name php conf rest <<<"${line%%#*}" || true
        [[ -n $name ]] || continue
        [[ ${php:--} != - ]] || php=$DEFAULT_PHP
        # "-" auto-detects common layouts, else the folder itself.
        root=${conf:=-}
        if [[ $root == - ]]; then
            root=.
            for d in public web public_html htdocs; do
                if [[ -d $SITES_PATH/$name/$d ]]; then root=$d; break; fi
            done
        fi
        SITE_NAMES+=("$name")
        SITE_PHP+=("$php")
        SITE_ROOT+=("$root")
        SITE_ROOT_CONF+=("$conf")
        SITE_DOMAIN+=("$name.$NOVACORE_TLD")
        SITE_DB+=("${name//[-.]/_}")
    done < "$SITES_CONF"
}

# site_index NAME — SITE = the site's index in the SITE_ arrays. Fails if
# there's no such site.
site_index() {
    for (( SITE = 0; SITE < ${#SITE_NAMES[@]}; SITE++ )); do
        [[ ${SITE_NAMES[SITE]} != "$1" ]] || return 0
    done
    return 1
}

php_service() { echo "php${1//./}"; }

# require_site NAME — fail unless the site exists. Sets SITE, like site_index.
require_site() { site_index "$1" || fail "No site called '$1'" "Run novacore site list to see your sites"; }

check_name() {
    [[ $1 =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] ||
        fail "Site names may only contain lowercase letters, numbers and hyphens"
    [[ $1 != default ]] || fail "'default' is a reserved name"
}

check_php() {
    local v
    for v in "${SUPPORTED_PHP[@]}"; do [[ $v == "$1" ]] && return 0; done
    fail "Unsupported PHP version '$1'" "Supported versions: ${SUPPORTED_PHP[*]}"
}

sites_conf_init() {
    [[ -f $SITES_CONF ]] && return
    cat > "$SITES_CONF" <<'EOF'
# Novacore sites, one per line. Edit by hand and run `novacore reload`, or use
# `novacore site add` / `novacore php <site> <version>`.
#
# php:  PHP version, or "-" for DEFAULT_PHP from .env
# root: document root inside the site folder, or "-" to auto-detect
#       (public, web, public_html, htdocs, else the folder itself)
#
# name          php     root
EOF
}

# sites_conf_set NAME PHP ROOT — replace the site's line, or append one.
sites_conf_set() {
    sites_conf_init
    rewrite "$SITES_CONF" -v n="$1" -v line="$(printf '%-15s %-7s %s' "$1" "$2" "$3")" '
        { s = $0; sub(/#.*/, "", s); split(s, f) }
        f[1] == n { if (!done) print line; done = 1; next }
        { print }
        END { if (!done) print line }'
    load_sites
}

sites_conf_remove() {
    rewrite "$SITES_CONF" -v n="$1" '{ s = $0; sub(/#.*/, "", s); split(s, f) } f[1] != n'
    load_sites
}

# --- Generated config --------------------------------------------------------

# The PHP versions in use: each site's, and DEFAULT_PHP.
needed_php() {
    printf '%s\n' "$DEFAULT_PHP" ${SITE_PHP[@]+"${SITE_PHP[@]}"} | sort -uV
}

needed_services() {
    local v
    for v in $(needed_php); do php_service "$v"; done
}

# PHP versions no site uses (nor DEFAULT_PHP), e.g. after switching a site.
unused_php() {
    local needed v
    needed=$(needed_php)
    for v in "${SUPPORTED_PHP[@]}"; do
        has_line "$needed" "$v" || echo "$v"
    done
}

# PHP services with a container, running or not, that no site uses.
unused_php_containers() {
    local existing v
    existing=$(services -a 2>/dev/null) || true
    for v in $(unused_php); do
        if has_line "$existing" "$(php_service "$v")"; then php_service "$v"; fi
    done
}

# php80 → 8.0
service_php() { echo "${1:3:1}.${1:4}"; }

# Stop and remove the containers of PHP versions no site uses any more.
remove_unused_containers() {
    local services=() s versions=()
    for s in $(unused_php_containers); do services+=("$s"); versions+=("$(service_php "$s")"); done
    (( ${#services[@]} )) || return 0
    run compose rm -sf "${services[@]}" || fail "Couldn't stop the unused PHP containers"
    result "Stopped PHP $(join ', ' "${versions[@]}"), which no site uses"
}

ensure_certs() {
    local missing=() d
    for d in localhost ${SITE_DOMAIN[@]+"${SITE_DOMAIN[@]}"}; do
        [[ -f $DATA_DIR/certs/$d.crt ]] || missing+=("$d")
    done
    (( ${#missing[@]} )) || return 0
    run compose run --rm --no-deps -T --user "$(id -u):$(id -g)" \
        --entrypoint novacore-cert nginx "${missing[@]}" ||
        fail "Couldn't issue certificates"
    result "Issued $(count ${#missing[@]} certificate certificates): $(join ', ' "${missing[@]}")"
}

# write_vhost INDEX — a site's nginx config.
write_vhost() {
    local name=${SITE_NAMES[$1]} php=${SITE_PHP[$1]} root=${SITE_ROOT[$1]} dom=${SITE_DOMAIN[$1]} docroot
    docroot="/var/www/sites/$name"
    [[ $root == . ]] || docroot+="/${root#./}"

    cat > "$DATA_DIR/nginx/sites/$name.conf" <<EOF
# Generated by novacore from sites.conf. Changes here are overwritten.
server {
    listen 80;
    listen 443 ssl;
    http2 on;
    server_name $dom *.$dom;

    ssl_certificate     /etc/novacore/certs/$dom.crt;
    ssl_certificate_key /etc/novacore/certs/$dom.key;

    root $docroot;
    index index.php index.html index.htm;

    # List a directory's files when it has no index file, instead of a 403.
    # Dotfiles are left out of the listing.
    autoindex on;
    autoindex_exact_size off;
    autoindex_localtime on;

    location / {
        try_files \$uri \$uri/ /index.php?\$query_string;
    }

    location ~ \.php(/|\$) {
        fastcgi_split_path_info ^(.+?\.php)(/.*)\$;
        set \$path_info \$fastcgi_path_info;
        try_files \$fastcgi_script_name =404;

        set \$php_upstream $(php_service "$php"):9000;
        fastcgi_pass \$php_upstream;
        fastcgi_index index.php;

        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME \$realpath_root\$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT \$realpath_root;
        fastcgi_param PATH_INFO \$path_info;
        fastcgi_param HTTPS \$https if_not_empty;
        fastcgi_param PHP_VALUE "error_log=/var/log/novacore/$name.log";
        fastcgi_param NOVACORE_DB_HOST mariadb;
    }

    location ~ /\.(?!well-known) {
        deny all;
    }
}
EOF
}

# Where the host's SSH agent can be mounted from, if anywhere.
#
# Docker Desktop (macOS, Linux) and OrbStack run containers in a VM, so host
# sockets can't be mounted directly; they forward the agent to a fixed path
# instead. Docker Engine on Linux, and Docker Desktop's WSL2 integration on
# Windows (the VM is WSL's own), can mount $SSH_AUTH_SOCK as it is.
#
# Sets SSH_AGENT, empty for nowhere. It's worked out once, as asking which
# Docker this is takes a moment.
ssh_agent_source() {
    [[ -z ${SSH_AGENT+set} ]] || return 0
    local os
    os=$(docker info --format '{{.OperatingSystem}}' 2>/dev/null) || true
    SSH_AGENT=''
    if [[ $os =~ Docker\ Desktop|OrbStack ]] && ! grep -qi microsoft /proc/version 2>/dev/null; then
        SSH_AGENT=/run/host-services/ssh-auth.sock
    elif [[ -S ${SSH_AUTH_SOCK:-} ]]; then
        SSH_AGENT=$SSH_AUTH_SOCK
    fi
}

# Docker Compose overrides that depend on the sites and on this machine.
write_overrides() {
    local d v
    ssh_agent_source
    {
        echo "# Generated by novacore. Do not edit."
        echo "services:"

        # Network aliases let containers reach sites by domain too (e.g.
        # WordPress loopback requests), since *.localhost only means 127.0.0.1
        # on the host.
        echo "  nginx:"
        echo "    networks:"
        echo "      novacore:"
        echo "        aliases:"
        for d in ${SITE_DOMAIN[@]+"${SITE_DOMAIN[@]}"}; do echo "          - $d"; done
        (( ${#SITE_DOMAIN[@]} )) || echo "          - novacore.$NOVACORE_TLD"

        # Share the host's SSH agent, known hosts and SSH config with PHP, for
        # remote work like `wp sync` or private Composer packages. Private keys
        # stay on the host. SELinux would relabel the host files with :z, so
        # labelling is turned off for these containers instead.
        if [[ -n $SSH_AGENT ]]; then
            for v in "${SUPPORTED_PHP[@]}"; do
                echo "  $(php_service "$v"):"
                echo "    security_opt: [\"label=disable\"]"
                echo "    environment:"
                echo "      SSH_AUTH_SOCK: /run/novacore/ssh-agent.sock"
                echo "    volumes:"
                echo "      - \"$SSH_AGENT:/run/novacore/host-agent.sock\""
                [[ -f $HOME/.ssh/known_hosts ]] && echo "      - \"$HOME/.ssh/known_hosts:/etc/novacore/ssh/known_hosts:ro\""
                [[ -f $HOME/.ssh/config ]] && echo "      - \"$HOME/.ssh/config:/etc/novacore/ssh/config:ro\""
            done
        fi
    } > "$DATA_DIR/compose.generated.yml"
    rm -f "$DATA_DIR/compose.sites.yml"  # Replaced by compose.generated.yml.
}

# Whether remote SSH commands will have your keys: a summary line, and a hint
# in SSH_HINT when they won't.
ssh_agent_status() {
    local status=0
    SSH_HINT=''
    ssh_agent_source
    if [[ -z $SSH_AGENT ]]; then
        detail "SSH agent" "none found"
        SSH_HINT="Without an SSH agent, commands like wp sync can't use your SSH keys"
        return
    fi
    # On Docker Desktop this asks the agent it forwards, which is the host's.
    ssh-add -l >/dev/null 2>&1 || status=$?
    if (( status == 1 )); then
        detail "SSH agent" "shared with PHP, but it has no keys"
        SSH_HINT="Run ssh-add, or add AddKeysToAgent yes to ~/.ssh/config"
    else
        detail "SSH agent" "shared with PHP"
    fi
}

# Fill in the dashboard template (dashboard/index.html) served at https://localhost,
# alongside its icon.
write_index() {
    local i dom rows="" page
    for (( i = 0; i < ${#SITE_NAMES[@]}; i++ )); do
        dom=${SITE_DOMAIN[i]}
        rows+="<tr><td><a href=\"https://$dom\" target=\"_blank\" rel=\"noopener\">$dom</a></td><td>PHP ${SITE_PHP[i]}</td><td><code>${SITE_DB[i]}</code></td><td><code>${SITE_ROOT[i]}</code></td></tr>"
    done
    [[ -n $rows ]] || rows='<tr><td colspan="4">No sites yet. Run <code>novacore site add &lt;name&gt;</code>.</td></tr>'

    page=$(<"$NOVACORE_ROOT/dashboard/index.html")
    page=${page//'{{SITE_ROWS}}'/$rows}
    page=${page//'{{DB_USER}}'/$DB_USER}
    page=${page//'{{DB_PASSWORD}}'/$DB_PASSWORD}
    page=${page//'{{DB_PORT}}'/$DB_PORT}
    page=${page//'{{NOVACORE_TLD}}'/$NOVACORE_TLD}
    printf '%s\n' "$page" > "$DATA_DIR/nginx/www/index.html"
    cp "$NOVACORE_ROOT/dashboard/novacore.svg" "$DATA_DIR/nginx/www/novacore.svg"
}

check_sites_conf() {
    local i
    for (( i = 0; i < ${#SITE_NAMES[@]}; i++ )); do
        check_name "${SITE_NAMES[i]}"
        check_php "${SITE_PHP[i]}"
    done
    [[ -z $(printf '%s\n' ${SITE_NAMES[@]+"${SITE_NAMES[@]}"} | sort | uniq -d) ]] ||
        fail "sites.conf lists the same site twice"
}

generate() {
    check_php "$DEFAULT_PHP"
    check_sites_conf
    ensure_certs
    rm -f "$DATA_DIR"/nginx/sites/*.conf
    local i name
    for (( i = 0; i < ${#SITE_NAMES[@]}; i++ )); do
        name=${SITE_NAMES[i]}
        [[ -d $SITES_PATH/$name ]] || warn "$name has no folder at $SITES_PATH/$name"
        write_vhost "$i"
        : >> "$LOGS_DIR/$name.log"
    done
    write_overrides
    write_index
    result "Wrote config for $(count ${#SITE_NAMES[@]} site sites)"
}

is_running() {
    local running
    running=$(services --filter status=running 2>/dev/null) && has_line "$running" nginx
}
require_running() { is_running || fail "Novacore isn't running" "Start it with novacore up"; }

start_services() {
    local services
    # shellcheck disable=SC2207
    services=(nginx mariadb $(needed_services))
    run compose up -d --wait --remove-orphans "${services[@]}" ||
        fail "Couldn't start the containers" "Run novacore logs to see why"
    compose exec -T nginx nginx -s reload >/dev/null 2>&1 || true
    # The init script grants this on first run, but it can fail silently (e.g. a
    # bind mount Docker Desktop won't let the entrypoint read), so ensure it here.
    db_sql -e "GRANT ALL PRIVILEGES ON *.* TO \`$DB_USER\`@'%' WITH GRANT OPTION" >/dev/null 2>&1 ||
        warn "Couldn't give $DB_USER access to all databases"
    # The reload signal returns before old workers retire; give them a moment.
    sleep 0.5
    result "Running $(join ', ' "${services[@]}")"
    remove_unused_containers
}

stop_services() {
    run compose down --remove-orphans || fail "Couldn't stop the containers"
    result "Stopped"
}

# Build a PHP version's image before pointing anything at it, so a failed
# build leaves the current config untouched.
ensure_php_image() {
    load_built_php
    ! php_built "$1" || return 0
    heading "PHP $1 image"
    run compose build "$(php_service "$1")" || fail "Couldn't build the PHP $1 image"
    result "Built novacore/php:$1"
}

# The PHP versions with an image, in BUILT_PHP, e.g. " 8.2 8.4 ".
load_built_php() {
    BUILT_PHP=" $(docker image ls novacore/php --format '{{.Tag}}' 2>/dev/null | sort -V | tr '\n' ' ')" || true
}

# php_built X.Y — whether PHP X.Y's image exists. Needs load_built_php first.
php_built() { [[ $BUILT_PHP == *" $1 "* ]]; }

# Bring the containers in line with the config, if the stack is running.
# APPLIED says whether it was; if not, the change waits for novacore up.
apply_containers() {
    APPLIED=0
    is_running || return 0
    heading Containers
    start_services
    APPLIED=1
}

# Regenerate config, and apply it straight away if the stack is running.
apply() {
    heading Configuration
    generate
    apply_containers
}

# finish MESSAGE — the closing line of a command that changed the config,
# with a hint if the change is still to be applied.
finish() {
    complete "$1"
    if (( ! APPLIED )); then
        echo
        hint "It applies when you next run novacore up"
    fi
    echo
}

# --- Commands ----------------------------------------------------------------

cmd_up() {
    if [[ ${1:-} == --restart ]]; then
        header Restarting
        heading Containers
        stop_services
    else
        header Starting
    fi
    mkdir -p "$SITES_PATH"
    heading Configuration
    generate
    heading Containers
    start_services

    complete Ready
    echo
    detail Dashboard https://localhost
    detail Sites "${#SITE_NAMES[@]}"
    detail Xdebug "$XDEBUG_MODE"
    ssh_agent_status
    if [[ -n $SSH_HINT || ! -f $DATA_DIR/.trusted ]]; then
        echo
        [[ -z $SSH_HINT ]] || hint "$SSH_HINT"
        [[ -f $DATA_DIR/.trusted ]] || hint "Run novacore trust once so your browser accepts Novacore's certificates"
    fi
    echo
}

cmd_down() {
    header Stopping
    heading Containers
    stop_services
    complete Stopped
    echo
}

cmd_reload() {
    header Reloading
    apply
    if (( APPLIED )); then finish Reloaded; else finish "Config regenerated"; fi
}

cmd_status() {
    if [[ ${1:-} == --json ]]; then status_json; return; fi
    local service state status mark
    heading Containers
    is_running || note "Not running. Start Novacore with novacore up."
    while IFS=$'\t' read -r service state status; do
        if [[ $state == running ]]; then mark=$(color "✔ $(printf '%-14s' "$service")" 32)
        else mark=$(color "! $(printf '%-14s' "$service")" 33)
        fi
        printf '  %s  %s\n' "$mark" "$(color "$status" 90)"
    done < <(compose ps -a --format '{{.Service}}{{"\t"}}{{.State}}{{"\t"}}{{.Status}}' 2>/dev/null)
    heading Sites
    site_list
    echo
}

# --- JSON ---
#
# These set REPLY rather than printing, as the tray menu builds hundreds of
# values and a subshell for each would be slow.

# js STRING — REPLY = STRING as a JSON string.
js() {
    local s=${1//\\/\\\\}
    s=${s//\"/\\\"}
    REPLY="\"$s\""
}

# jlist JSON... — REPLY = a JSON array of values that are JSON already.
jlist() { local IFS=,; REPLY="[$*]"; }

# jstrs STRING... — REPLY = a JSON array of strings.
jstrs() {
    local out=() s
    for s in "$@"; do js "$s"; out+=("$REPLY"); done
    jlist ${out[@]+"${out[@]}"}
}

# jpairs KEY STRING... — REPLY = the members of a JSON object whose values are
# strings: "KEY":"STRING",...
jpairs() {
    local out=()
    while (( $# >= 2 )); do js "$2"; out+=("\"$1\":$REPLY"); shift 2; done
    local IFS=,
    REPLY="${out[*]}"
}

# jobj KEY STRING... — REPLY = a JSON object whose values are strings.
jobj() { jpairs "$@"; REPLY="{$REPLY}"; }

# Whether Novacore is running, and its sites, for tools like the Plasma widget.
status_json() {
    local running=false i sep=""
    is_running && running=true
    load_built_php
    printf '{"running":%s,"dashboard":"https://localhost",' "$running"
    jstrs "${SUPPORTED_PHP[@]}"; printf '"phpVersions":%s,' "$REPLY"
    # shellcheck disable=SC2086
    jstrs $BUILT_PHP; printf '"builtPhp":%s,' "$REPLY"
    jpairs defaultPhp "$DEFAULT_PHP" xdebug "$XDEBUG_MODE" tld "$NOVACORE_TLD" sitesPath "$SITES_PATH"
    printf '%s,' "$REPLY"
    jobj user "$DB_USER" password "$DB_PASSWORD" host "$HOST_DB_HOST" containerHost mariadb
    printf '"db":%s,"sites":[' "$REPLY"
    for (( i = 0; i < ${#SITE_NAMES[@]}; i++ )); do
        jobj name "${SITE_NAMES[i]}" url "https://${SITE_DOMAIN[i]}" php "${SITE_PHP[i]}" root "${SITE_ROOT[i]}" \
            path "$SITES_PATH/${SITE_NAMES[i]}" database "${SITE_DB[i]}" errorLog "$LOGS_DIR/${SITE_NAMES[i]}.log"
        printf '%s%s' "$sep" "$REPLY"
        sep=,
    done
    printf ']}\n'
}

cmd_logs() { compose logs -f --tail=100 "$@"; }

# Follow a site's PHP error log, or every site's when no site is given.
cmd_errors() {
    local name=${1:-}
    if [[ -z $name ]]; then
        local files=("$LOGS_DIR"/*.log)
        [[ -e ${files[0]} ]] || fail "No error logs yet"
        tail -n 20 -F "${files[@]}"
        return
    fi
    require_site "$name"
    local file="$LOGS_DIR/$name.log"
    case ${2:-} in
        "")      ;;
        --clear) : > "$file"; color "✔ Cleared $file" 32; echo; return ;;
        *)       fail "Unknown option '$2'" "Usage: novacore errors [site] [--clear]" ;;
    esac
    : >> "$file"
    tail -n 50 -F "$file"
}

cmd_build() {
    local services
    if [[ ${1:-} == --all ]]; then
        services=(nginx)
        local v
        for v in "${SUPPORTED_PHP[@]}"; do services+=("$(php_service "$v")"); done
    else
        # shellcheck disable=SC2207
        services=(nginx $(needed_services))
    fi
    header "Building images"
    heading Images
    run compose build --pull "${services[@]}" || fail "Couldn't build the images"
    result "Built $(join ', ' "${services[@]}")"
    apply_containers
    complete Built
    echo
}

# Disk space used by Docker's images and build cache, in bytes.
docker_bytes() {
    docker system df --format '{{.Type}}{{"\t"}}{{.Size}}' | awk -F'\t' '
        $1 == "Images" || $1 == "Build Cache" {
            unit = $2; sub(/^[0-9.]+/, "", unit)
            total += ($2 + 0) * (unit == "kB" ? 1e3 : unit == "MB" ? 1e6 : unit == "GB" ? 1e9 : unit == "TB" ? 1e12 : 1)
        }
        END { printf "%.0f\n", total }'
}

# bytes N — e.g. "4.1 GB".
bytes() {
    awk -v b="$1" 'BEGIN {
        split("B kB MB GB TB", units); i = 1
        while (b >= 1000 && i < 5) { b /= 1000; i++ }
        printf(i == 1 ? "%d %s\n" : "%.1f %s\n", b, units[i])
    }'
}

# Remove the images of PHP versions no site uses, and with --cache, Docker's
# unused build cache. Novacore rebuilds an image when a site needs it again.
cmd_prune() {
    local cache=0 before v images=() versions=()
    case ${1:-} in
        "")      ;;
        --cache) cache=1 ;;
        *)       fail "Unknown option '$1'" "Usage: novacore prune [--cache]" ;;
    esac

    header Pruning
    before=$(docker_bytes)

    heading "Unused PHP versions"
    remove_unused_containers
    load_built_php
    for v in $(unused_php); do
        if php_built "$v"; then
            images+=("novacore/php:$v")
            versions+=("$v")
        fi
    done
    if (( ${#images[@]} )); then
        run docker image rm "${images[@]}" || fail "Couldn't remove the images"
        # The official images they're built on, unless something else uses them.
        for v in "${versions[@]}"; do
            docker image rm "php:$v-fpm" >/dev/null 2>&1 || true
        done
        result "Removed the PHP $(join ', ' "${versions[@]}") images"
    else
        result "No unused PHP images"
    fi

    if (( cache )); then
        heading "Build cache"
        run docker builder prune -f || fail "Couldn't clear the build cache"
        result "Cleared Docker's unused build cache"
    fi

    complete "Freed $(bytes $(( before - $(docker_bytes) )))"
    echo
    (( cache )) || hint "novacore prune --cache also clears Docker's unused build cache, which only speeds up rebuilds"
    echo
}

placeholder_page() {
    cat <<'EOF'
<?php
// Placeholder created by novacore. Replace it with your site.
$xdebug = extension_loaded('xdebug') ? 'Xdebug ' . phpversion('xdebug') . ' (' . getenv('XDEBUG_MODE') . ')' : 'Xdebug not loaded';
?>
<!doctype html>
<meta charset="utf-8">
<title><?= htmlspecialchars($_SERVER['HTTP_HOST']) ?></title>
<style>body { font: 16px/1.5 system-ui, sans-serif; max-width: 640px; margin: 64px auto; padding: 0 16px; }</style>
<h1><?= htmlspecialchars($_SERVER['HTTP_HOST']) ?></h1>
<p>PHP <?= PHP_VERSION ?> · <?= $xdebug ?> · <?= empty($_SERVER['HTTPS']) ? 'http' : 'https' ?></p>
<p>Served from <code><?= htmlspecialchars(__DIR__) ?></code></p>
EOF
}

site_add() {
    local name="" php=$DEFAULT_PHP root=- db=1
    local usage="Usage: novacore site add <name> [--php X.Y] [--root DIR] [--no-db]"
    while (( $# )); do
        case $1 in
            --php)    php=${2:-}; [[ -n $php ]] || fail "--php needs a version"; shift 2 ;;
            --php=*)  php=${1#*=}; shift ;;
            --root)   root=${2:-}; [[ -n $root ]] || fail "--root needs a directory"; shift 2 ;;
            --root=*) root=${1#*=}; shift ;;
            --no-db)  db=0; shift ;;
            -*)       fail "Unknown option '$1'" "$usage" ;;
            *)        [[ -z $name ]] || fail "Unexpected argument '$1'"; name=$1; shift ;;
        esac
    done
    [[ -n $name ]] || fail "Which site?" "$usage"
    check_name "$name"
    check_php "$php"
    ! site_index "$name" || fail "Site '$name' already exists"

    header "Adding $name"
    ensure_php_image "$php"

    heading "Site folder"
    local dir="$SITES_PATH/$name"
    if [[ ! -d $dir ]]; then
        local docroot=$dir
        [[ $root == - ]] || docroot="$dir/$root"
        mkdir -p "$docroot"
        placeholder_page > "$docroot/index.php"
        result "Created $dir"
    else
        result "Using the existing folder $dir"
    fi

    sites_conf_set "$name" "$php" "$root"
    apply
    site_index "$name"

    local dbname=${SITE_DB[SITE]}
    if (( db )); then
        heading Database
        if (( APPLIED )); then
            db_create "$dbname"
        else
            warn "Novacore isn't running, so no database was created"
            db=0
        fi
    fi

    complete "Added $name"
    echo
    detail URL "https://${SITE_DOMAIN[SITE]}"
    detail PHP "$php"
    detail "Doc root" "${SITE_ROOT[SITE]}"
    if (( db )); then
        detail Database "$dbname"
    fi
    echo
    if (( APPLIED )); then
        hint "Run novacore site info $name for its database settings"
    else
        hint "Start Novacore with novacore up, then run novacore db create $dbname"
    fi
    echo
}

# Ways to set DB_HOST that work both in Novacore and on your machine, in
# SNIPPETS: a label, then its code, for each.
db_host_snippets() {
    SNIPPETS=(
        "wp-config.php"
        "define( 'DB_HOST', getenv( 'NOVACORE_DB_HOST' ) ?: '$HOST_DB_HOST' );"
        "Bedrock (config/application.php)"
        "Config::define( 'DB_HOST', env( 'NOVACORE_DB_HOST' ) ?: env( 'DB_HOST' ) ?: '$HOST_DB_HOST' );"
        "Laravel (config/database.php)"
        "'host' => env( 'NOVACORE_DB_HOST', env( 'DB_HOST', '127.0.0.1' ) ),"
    )
}

site_info() {
    local name=${1:-} dbname state="" i
    [[ -n $name ]] || fail "Which site?" "Usage: novacore site info <name>"
    require_site "$name"
    dbname=${SITE_DB[SITE]}
    if is_running && [[ -z $(db_sql -N -e "SHOW DATABASES LIKE '$dbname'") ]]; then
        state=" $(color "(not created yet: novacore db create $dbname)" 33)"
    fi

    heading "$name"
    detail URL "https://${SITE_DOMAIN[SITE]}"
    detail PHP "${SITE_PHP[SITE]}"
    detail Folder "$SITES_PATH/$name"
    detail "Doc root" "${SITE_ROOT[SITE]}"
    detail "Error log" "$LOGS_DIR/$name.log"

    heading Database
    detail Name "$dbname$state"
    detail User "$DB_USER"
    detail Password "$DB_PASSWORD"
    detail Host "mariadb (inside Novacore), $HOST_DB_HOST (your machine)"

    heading Connecting
    echo "  To connect from both Novacore and tools on your machine, such as wp, use:"
    echo
    db_host_snippets
    for (( i = 0; i < ${#SNIPPETS[@]}; i += 2 )); do
        note "${SNIPPETS[i]}"
        echo "    ${SNIPPETS[i + 1]}"
        echo
    done
}

site_rm() {
    local name="" drop_db=0
    while (( $# )); do
        case $1 in
            --drop-db) drop_db=1; shift ;;
            -*)        fail "Unknown option '$1'" "Usage: novacore site rm <name> [--drop-db]" ;;
            *)         name=$1; shift ;;
        esac
    done
    [[ -n $name ]] || fail "Which site?" "Usage: novacore site rm <name> [--drop-db]"
    require_site "$name"
    # Check before removing anything, so the site isn't left half removed.
    if (( drop_db )); then require_running; fi

    header "Removing $name"
    local dbname=${SITE_DB[SITE]}
    rm -f "$DATA_DIR/certs/${SITE_DOMAIN[SITE]}".{crt,key}
    sites_conf_remove "$name"
    apply
    if (( drop_db )); then
        heading Database
        db_drop "$dbname"
    fi
    complete "Removed $name"
    echo
    message Note "Its files are still in $SITES_PATH/$name"
    echo
}

site_list() {
    if (( ! ${#SITE_NAMES[@]} )); then
        note "No sites yet. Add one with novacore site add <name>."
        return
    fi
    local i
    note "$(printf '%-36s %-6s %s' URL PHP ROOT)"
    for (( i = 0; i < ${#SITE_NAMES[@]}; i++ )); do
        printf '  %-36s %-6s %s\n' "https://${SITE_DOMAIN[i]}" "${SITE_PHP[i]}" "${SITE_ROOT[i]}"
    done
}

cmd_site() {
    local sub=${1:-list}
    shift || true
    case $sub in
        add|new)      site_add "$@" ;;
        rm|remove)    site_rm "$@" ;;
        ls|list)      site_list ;;
        info)         site_info "$@" ;;
        *)            fail "Unknown command 'site $sub'" "Try site add, rm, list or info" ;;
    esac
}

cmd_php() {
    case ${1:-list} in
        list|ls)
            local running v marks
            running=$(services --filter status=running 2>/dev/null) || true
            for v in "${SUPPORTED_PHP[@]}"; do
                marks=""
                [[ $v == "$DEFAULT_PHP" ]] && marks+="  $(color default 90)"
                has_line "$running" "$(php_service "$v")" && marks+="  $(color running 32)"
                echo "  $v$marks"
            done
            ;;
        default)
            [[ -n ${2:-} ]] || { echo "$DEFAULT_PHP"; return; }
            check_php "$2"
            header "Default PHP → $2"
            ensure_php_image "$2"
            env_set DEFAULT_PHP "$2"
            load_sites
            apply
            complete "Default PHP is now $2"
            echo
            ;;
        *)
            local name=$1 version=${2:-}
            require_site "$name"
            [[ -n $version ]] || { echo "${SITE_PHP[SITE]}"; return; }
            check_php "$version"
            header "$name → PHP $version"
            ensure_php_image "$version"
            sites_conf_set "$name" "$version" "${SITE_ROOT_CONF[SITE]}"
            apply
            complete "$name now runs PHP $version"
            echo
            ;;
    esac
}

cmd_xdebug() {
    local mode
    case ${1:-} in
        "")      echo "Xdebug mode: $XDEBUG_MODE"; return ;;
        on)      mode=develop,debug ;;
        off)     mode=off ;;
        *)       mode=$1 ;;
    esac
    [[ $mode =~ ^[a-z]+(,[a-z]+)*$ ]] || fail "Invalid Xdebug mode '$mode'" "Try on, off, or modes like debug,profile"
    header "Xdebug → $mode"
    env_set XDEBUG_MODE "$mode"
    # Compose recreates the PHP containers because their environment changed.
    apply_containers
    finish "Xdebug mode is now $mode"
}

# db_exec [-T] mariadb PROGRAM... — run one of MariaDB's programs in its
# container, with root's password.
db_exec() { compose exec -e MYSQL_PWD="$DB_ROOT_PASSWORD" "$@"; }

# db_sql OPTION... — run SQL from stdin or -e. Needs Novacore running.
db_sql() { db_exec -T mariadb mariadb -uroot "$@"; }

check_db_name() {
    [[ ${1:-} =~ ^[A-Za-z0-9_]+$ ]] || fail "Database names may only contain letters, numbers and underscores"
}

db_create() {
    check_db_name "${1:-}"
    run db_sql -e "CREATE DATABASE IF NOT EXISTS \`$1\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci" ||
        fail "Couldn't create the database $1"
    result "Database $1 is ready"
}

db_drop() {
    check_db_name "${1:-}"
    run db_sql -e "DROP DATABASE IF EXISTS \`$1\`" || fail "Couldn't drop the database $1"
    result "Dropped the database $1"
}

# import_sql NAME FILE — load a .sql or .sql.gz file into a database.
import_sql() {
    case $2 in
        *.gz) gunzip -c "$2" | db_sql "$1" ;;
        *)    db_sql "$1" < "$2" ;;
    esac
}

# export_sql NAME FILE — dump a database to a .sql or .sql.gz file.
export_sql() {
    db_exec -T mariadb mariadb-dump -uroot --single-transaction --routines --triggers "$1" |
        if [[ $2 == *.gz ]]; then gzip; else cat; fi > "$2"
}

file_size() { du -h "$1" | cut -f1; }

cmd_db() {
    local sub=${1:-list}
    shift || true
    case $sub in
        create|drop)
            check_db_name "${1:-}"
            require_running
            if [[ $sub == create ]]; then header "Creating $1"; else header "Dropping $1"; fi
            heading Database
            "db_$sub" "$1"
            if [[ $sub == create ]]; then complete "Created $1"; else complete "Dropped $1"; fi
            echo
            ;;
        list|ls)
            require_running
            db_sql -N -e "SHOW DATABASES" |
                grep -vxE 'information_schema|mysql|performance_schema|sys' || true
            ;;
        import)
            local name=${1:-} file=${2:-}
            [[ -n $name && -n $file ]] || fail "Which database and file?" "Usage: novacore db import <name> <file.sql[.gz]>"
            check_db_name "$name"
            [[ -f $file ]] || fail "No file at $file"
            require_running
            header "Importing $(basename "$file")"
            heading Database
            db_create "$name"
            heading Import
            run import_sql "$name" "$file" || fail "Couldn't import $file"
            result "Imported $(file_size "$file") into $name"
            complete "Imported"
            echo
            ;;
        export)
            local name=${1:-} file
            check_db_name "$name"
            file=${2:-$name-$(date +%Y%m%d-%H%M%S).sql.gz}
            require_running
            header "Exporting $name"
            heading Export
            run export_sql "$name" "$file" || { rm -f "$file"; fail "Couldn't export $name"; }
            result "Wrote $file ($(file_size "$file"))"
            complete "Exported"
            echo
            ;;
        shell)
            require_running
            db_exec mariadb mariadb -uroot "$@"
            ;;
        *) fail "Unknown command 'db $sub'" "Try db create, drop, list, import, export or shell" ;;
    esac
}

# Run a command in a site's PHP container, from the site folder, as your user.
cmd_exec() {
    local name=${1:-}
    [[ -n $name ]] || fail "Which site?" "Usage: novacore exec <site> <command...>"
    shift
    require_site "$name"
    require_running
    (( $# )) || set -- bash
    local tty=()
    [[ -t 0 && -t 1 ]] || tty=(-T)
    compose exec ${tty[@]+"${tty[@]}"} -u www-data -w "/var/www/sites/$name" \
        "$(php_service "${SITE_PHP[SITE]}")" "$@"
}

cmd_shell() {
    if [[ -n ${1:-} ]]; then
        cmd_exec "$1" bash
    else
        require_running
        compose exec -u www-data "$(php_service "$DEFAULT_PHP")" bash
    fi
}

cmd_open() {
    local url=https://localhost
    if [[ -n ${1:-} ]]; then
        require_site "$1"
        url="https://${SITE_DOMAIN[SITE]}"
    fi
    if command -v xdg-open >/dev/null; then xdg-open "$url" >/dev/null 2>&1 &
    elif command -v open >/dev/null; then open "$url"
    else echo "$url"
    fi
}

# Which system trust store to add the CA to, if Novacore knows how.
trust_store() {
    if [[ $(uname) == Darwin ]]; then echo macos
    elif [[ -d /etc/pki/ca-trust/source/anchors ]]; then echo fedora  # Fedora, RHEL
    elif [[ -d /usr/local/share/ca-certificates ]]; then echo debian  # Debian, Ubuntu
    elif command -v trust >/dev/null; then echo arch
    fi
}

# trust_install STORE CA — add the CA to a system trust store.
trust_install() {
    case $1 in
        macos)  sudo security add-trusted-cert -d -r trustRoot -k /Library/Keychains/System.keychain "$2" ;;
        fedora) sudo cp "$2" /etc/pki/ca-trust/source/anchors/novacore.crt && sudo update-ca-trust ;;
        debian) sudo cp "$2" /usr/local/share/ca-certificates/novacore.crt && sudo update-ca-certificates ;;
        arch)   sudo trust anchor --store "$2" ;;
    esac
}

# Whether this is WSL with Windows interop, so we can reach the Windows
# certificate store that Windows browsers use.
is_wsl() {
    [[ -n ${WSL_DISTRO_NAME:-} ]] || grep -qi microsoft /proc/sys/kernel/osrelease 2>/dev/null || return 1
    command -v certutil.exe >/dev/null && command -v wslpath >/dev/null
}

# windows_trust CA — add the CA to the Windows user's Trusted Root store.
# Windows shows a confirmation dialog, so this can't run under run().
windows_trust() {
    local ca=$1 sha1 status
    sha1=$(openssl x509 -in "$ca" -noout -fingerprint -sha1 | cut -d= -f2 | tr -d : | tr 'A-F' 'a-f')

    heading "Windows"
    note "Lets Chrome and Edge on Windows accept Novacore's certificates."
    if certutil.exe -user -verifystore Root "$sha1" >/dev/null 2>&1; then
        result "Already in the Windows certificate store"
        return
    fi
    note "Windows will ask you to confirm. Check the thumbprint is $sha1, then click Yes." 33
    set +e
    certutil.exe -user -addstore Root "$(wslpath -w "$ca")" >/dev/null 2>&1
    status=$?
    set -e
    # certutil can exit 0 when the dialog is declined, so check the store itself.
    if (( status )) || ! certutil.exe -user -verifystore Root "$sha1" >/dev/null 2>&1; then
        fail "Couldn't add the CA to the Windows certificate store" "Run novacore trust again and click Yes in the Windows dialog"
    fi
    result "Added to the Windows certificate store"
}

cmd_trust() {
    local ca="$DATA_DIR/certs/ca.crt" store
    store=$(trust_store)
    [[ -n $store ]] || fail "Don't know how to update the trust store here" "Import $ca into your browser by hand"

    header "Trusting the local CA"
    heading "Certificate authority"
    [[ -f $ca ]] || ensure_certs
    [[ -f $ca ]] || fail "Couldn't create the CA certificate"
    result "Novacore Local CA is at $ca"

    heading "System trust store"
    note "Lets browsers accept https://*.$NOVACORE_TLD without warnings. It needs sudo."
    # Ask for the password up front, since run hides the commands' prompts.
    sudo -v || fail "Couldn't get sudo access"
    run trust_install "$store" "$ca" || fail "Couldn't update the trust store"
    result "Added Novacore Local CA"

    # Chrome and Firefox on some distros keep their own NSS database.
    if command -v certutil >/dev/null && [[ -d $HOME/.pki/nssdb ]]; then
        heading "Chrome"
        run certutil -d "sql:$HOME/.pki/nssdb" -A -t "C,," -n "Novacore Local CA" -i "$ca" ||
            fail "Couldn't add the CA to Chrome's certificate store"
        result "Added to Chrome's certificate store"
    fi

    # On WSL, browsers run on Windows and use its store, not Linux's.
    is_wsl && windows_trust "$ca"

    touch "$DATA_DIR/.trusted"
    complete Trusted
    echo
    hint "Restart your browser if it was already open"
    echo
}

# --- Tray icons ---------------------------------------------------------------
#
# The macOS menu bar icon (macos/NovacoreTray.swift) and the Windows tray icon
# (windows/novacore-tray.ps1) share everything but drawing: `tray menu` tells
# them what to show and what each item does, `tray run` and `tray poll` run a
# command for them, and `tray submit` turns a dialog's answers into a command.
# So a new menu item or dialog only needs adding here, in tray_menu. The JSON
# is described in tray/PROTOCOL.md. The Plasma widget (plasmoid/) lists the
# sites itself, from `status --json`, but runs its commands the same way.
#
# Like the JSON functions they build on, these set REPLY.

# mitem LABEL ACTION FLAG... — REPLY = a menu item, with ACTION (JSON, or
# empty for none). FLAGs are bold, checked, idle (greyed out while a command
# from the tray runs) and off (greyed out). Empty ones are ignored.
mitem() {
    local f out
    js "$1"; out="{\"label\":$REPLY"
    [[ -z $2 ]] || out+=",\"action\":$2"
    shift 2
    for f in "$@"; do
        case $f in
            bold|checked|idle) out+=",\"$f\":true" ;;
            off)               out+=',"enabled":false' ;;
        esac
    done
    REPLY="$out}"
}

# msub LABEL ITEM... — REPLY = a submenu of ITEMs.
msub() {
    local label
    js "$1"; label=$REPLY
    shift
    jlist "$@"
    REPLY="{\"label\":$label,\"items\":$REPLY}"
}

MSEP='{"separator":true}'

# act TYPE VALUE [KEY VALUE]... — REPLY = an action made of strings, e.g.
# act open URL, act folder PATH, act editor PATH app zed, act terminal PATH
# title TITLE, or act tray output (the tray's own: output, refresh or quit).
act() { jobj "$@"; }

# act_console TITLE ARGS... — run novacore ARGS in a terminal.
act_console() {
    local title
    js "$1"; title=$REPLY
    shift
    jstrs "$@"
    REPLY="{\"console\":$REPLY,\"title\":$title}"
}

# act_run LABEL DONE URL ARGS... — run novacore ARGS through `tray run`,
# showing LABEL meanwhile and DONE after. URL, if set, opens when the
# notification is clicked.
act_run() {
    local rest
    jpairs label "$1" done "$2" ${3:+url "$3"}; rest=$REPLY
    shift 3
    jstrs "$@"
    REPLY="{\"run\":$REPLY,$rest}"
}

# repo_web PATH — the web page of the git repo at PATH, from its origin
# remote (or its first, without one): REPO_LABEL and REPO_URL, e.g. GitHub and
# https://github.com/me/blog. Fails if there's no repo or remote.
repo_web() {
    local remotes key value url="" first="" host rest
    # Only a repo of the site's own, not one its folder happens to be inside,
    # such as Novacore's.
    [[ -e $1/.git ]] || return 1
    remotes=$(git -C "$1" config --get-regexp '^remote\..*\.url$' 2>/dev/null) || return 1
    while read -r key value; do
        [[ -n $first ]] || first=$value
        if [[ $key == remote.origin.url ]]; then url=$value; break; fi
    done <<<"$remotes"
    url=${url:-$first}
    [[ -n $url ]] || return 1

    # Split into host and path: https://user@host:port/path, ssh://git@host:port/path
    # or scp-like git@host:path.
    if [[ $url =~ ^[a-z+]+://([^@/]*@)?([^/:]+)(:[0-9]+)?/(.*)$ ]]; then
        host=${BASH_REMATCH[2]} rest=${BASH_REMATCH[4]}
    elif [[ $url =~ ^([^@/]*@)?([^/:]+):(.*)$ ]]; then
        host=${BASH_REMATCH[2]} rest=${BASH_REMATCH[3]}
    else
        return 1  # A local path.
    fi
    # An SSH alias, such as github-work for a second account: its real host.
    if [[ $host != *.* && $url != http* ]] && command -v ssh >/dev/null; then
        host=$(ssh -G "$host" 2>/dev/null | awk '$1 == "hostname" { print $2; exit }') || return 1
    fi
    # Still no dot: an alias we couldn't resolve, so no page to link to.
    [[ $host == *.* ]] || return 1
    rest=${rest#/}
    rest=${rest%/}
    rest=${rest%.git}
    case $host in
        github.com|*.github.com) REPO_LABEL=GitHub ;;
        gitlab.com|gitlab.*)     REPO_LABEL=GitLab ;;
        bitbucket.org)           REPO_LABEL=Bitbucket ;;
        codeberg.org)            REPO_LABEL=Codeberg ;;
        ssh.dev.azure.com|vs-ssh.visualstudio.com|dev.azure.com)
            # v3/org/project/repo over SSH, org/project/_git/repo over HTTPS.
            REPO_LABEL="Azure DevOps"
            [[ $rest =~ ^v3/([^/]+)/([^/]+)/([^/]+)$ ]] && rest="${BASH_REMATCH[1]}/${BASH_REMATCH[2]}/_git/${BASH_REMATCH[3]}"
            host=dev.azure.com
            ;;
        *) REPO_LABEL=$host ;;
    esac
    REPO_URL="https://$host/$rest"
}

# The dialogs and menus below read what tray_menu worked out: TRAY_RUNNING, 1
# if Novacore is running, and WSL_ROOT, where Windows sees this distro's files
# (empty outside WSL).

# info_section HEADING LABEL VALUE... — REPLY = a section of an Info dialog.
info_section() {
    local heading rows=()
    js "$1"; heading=$REPLY
    shift
    while (( $# >= 2 )); do jstrs "$1" "$2"; rows+=("$REPLY"); shift 2; done
    jlist "${rows[@]}"
    REPLY="{\"heading\":$heading,\"rows\":$REPLY}"
}

# info_dialog INDEX — a site's details for its Info dialog, like `novacore
# site info`.
info_dialog() {
    local name=${SITE_NAMES[$1]} url="https://${SITE_DOMAIN[$1]}" root=${SITE_ROOT[$1]}
    local path="$SITES_PATH/$name" sections=() buttons=() wsl=() i
    [[ $root == . ]] && root=$path || root="$path/$root"
    [[ -z $WSL_ROOT ]] || wsl=("In Windows" "$WSL_ROOT${path//\//\\}")

    info_section Site URL "$url" PHP "${SITE_PHP[$1]}" Folder "$path" ${wsl[@]+"${wsl[@]}"} \
        "Document root" "$root" "Error log" "$LOGS_DIR/$name.log"
    sections+=("$REPLY")
    info_section Database Name "${SITE_DB[$1]}" User "$DB_USER" Password "$DB_PASSWORD" \
        Host "$HOST_DB_HOST" "Host in Novacore" mariadb
    sections+=("$REPLY")
    db_host_snippets
    # Their labels without the file each goes in, e.g. "(config/database.php)".
    for (( i = 0; i < ${#SNIPPETS[@]}; i += 2 )); do SNIPPETS[i]=${SNIPPETS[i]%% (*}; done
    info_section "DB_HOST that works in Novacore and on your machine" "${SNIPPETS[@]}"
    sections+=("$REPLY")

    act open "$url"; mitem "Open Site" "$REPLY"; buttons+=("$REPLY")
    act folder "$path"; mitem "Open Folder" "$REPLY"; buttons+=("$REPLY")
    jlist "${buttons[@]}"; local b=$REPLY
    jlist "${sections[@]}"; local s=$REPLY
    js "$name"
    REPLY="{\"dialog\":\"info\",\"title\":$REPLY,\"sections\":$s,\"buttons\":$b}"
}

# db_check ID LABEL VALUE — REPLY = a form's checkbox for something done to a
# database, so it's greyed out unless Novacore is running.
db_check() {
    if (( TRAY_RUNNING )); then
        js "$2"
        REPLY="{\"id\":\"$1\",\"type\":\"check\",\"label\":$REPLY,\"value\":$3}"
    else
        js "$2 (start Novacore first)"
        REPLY="{\"id\":\"$1\",\"type\":\"check\",\"label\":$REPLY,\"value\":false,\"enabled\":false}"
    fi
}

# The Add Site dialog.
add_site_dialog() {
    local v hints="" names php root db action
    # The same rules as check_name, and the names that are taken.
    jstrs default ${SITE_NAMES[@]+"${SITE_NAMES[@]}"}
    names=$REPLY
    for v in "${SUPPORTED_PHP[@]}"; do
        php_built "$v" && continue
        js "PHP $v needs building first, which takes a few minutes."
        hints+="${hints:+,}\"$v\":$REPLY"
    done
    jstrs "${SUPPORTED_PHP[@]}"
    php="{\"id\":\"php\",\"type\":\"choice\",\"label\":\"PHP\",\"options\":$REPLY,\"value\":\"$DEFAULT_PHP\",\"hints\":{$hints}}"
    root='{"id":"root","type":"combo","label":"Document root","options":["Auto-detect","public","web","public_html","htdocs"],"value":"Auto-detect","note":"Auto-detect looks for public, web, public_html or htdocs."}'
    db_check db "Create a database" true
    db=$REPLY
    act_run "Adding {name}…" "{name} is ready at https://{name}.$NOVACORE_TLD" "https://{name}.$NOVACORE_TLD" tray submit add-site
    action=$REPLY
    REPLY='{"dialog":"form","title":"Add Site","submit":"Add","fields":[
{"id":"name","type":"text","label":"Name","lowercase":true,"hint":"https://{value}.'"$NOVACORE_TLD"'","rules":[
{"match":"^[a-z0-9]([a-z0-9-]*[a-z0-9])?$","error":"Use letters, numbers and hyphens, not at the start or end."},
{"notIn":'"$names"',"error":"There'"'"'s already a site called {value}, or it'"'"'s reserved."}]},
'"$php,$root,$db"'],"action":'"$action"'}'
}

# remove_site_dialog INDEX — the Remove dialog for a site.
remove_site_dialog() {
    local name=${SITE_NAMES[$1]} path="$SITES_PATH/${SITE_NAMES[$1]}" text db action
    jpairs title "Remove $name" heading "Stop serving https://${SITE_DOMAIN[$1]}?" message "Its files stay in $path."
    text=$REPLY
    db_check drop-db "Also delete its database, ${SITE_DB[$1]}" false
    db=$REPLY
    act_run "Removing ${name}…" "Removed $name. Its files are still in $path" "" tray submit remove-site "site=$name"
    action=$REPLY
    REPLY="{\"dialog\":\"form\",$text,\"submit\":\"Remove\",\"destructive\":true,\"fields\":[$db],\"action\":$action}"
}

# site_menu INDEX — REPLY = a site's submenu.
site_menu() {
    local name=${SITE_NAMES[$1]} url="https://${SITE_DOMAIN[$1]}" php=${SITE_PHP[$1]}
    local path="$SITES_PATH/$name" sub=() v label off=""
    (( TRAY_RUNNING )) || off=off

    act open "$url"; mitem "Open ${url#https://}" "$REPLY" bold; sub+=("$REPLY")
    if repo_web "$path"; then
        act open "$REPO_URL"; mitem "Open on $REPO_LABEL" "$REPLY"; sub+=("$REPLY")
    fi
    info_dialog "$1"; mitem "Info…" "$REPLY"; sub+=("$REPLY" "$MSEP")
    act folder "$path"; mitem "Open Folder" "$REPLY"; sub+=("$REPLY")
    act editor "$path" app vscode; mitem "Open in VS Code" "$REPLY"; sub+=("$REPLY")
    act editor "$path" app zed; mitem "Open in Zed" "$REPLY"; sub+=("$REPLY")
    act terminal "$path" title "$name"; mitem "Open Terminal" "$REPLY"; sub+=("$REPLY")
    act_console "$name · PHP shell" shell "$name"; mitem "PHP Shell" "$REPLY" "$off"; sub+=("$REPLY")
    act_console "$name · error log" errors "$name"; mitem "Follow Error Log" "$REPLY"; sub+=("$REPLY" "$MSEP")
    for v in "${SUPPORTED_PHP[@]}"; do
        if [[ $v == "$php" ]]; then
            mitem "PHP $v" "" checked idle
        else
            if php_built "$v"; then label="Switching $name to PHP ${v}…"; else label="Building PHP ${v}…"; fi
            act_run "$label" "$name now uses PHP $v" "" php "$name" "$v"
            mitem "PHP $v" "$REPLY" idle
        fi
        sub+=("$REPLY")
    done
    sub+=("$MSEP")
    remove_site_dialog "$1"; mitem "Remove…" "$REPLY" idle; sub+=("$REPLY")
    msub "$name" "${sub[@]}"
}

# REPLY = the Xdebug submenu: novacore xdebug's modes, where "on" is
# develop,debug.
xdebug_menu() {
    local sub=() known=0 mode label
    for mode in off:Off "develop,debug:On (develop, debug)" - debug:"Debug only" develop:"Develop only" \
        profile:Profile trace:Trace coverage:Coverage; do
        if [[ $mode == - ]]; then sub+=("$MSEP"); continue; fi
        label=${mode#*:}
        mode=${mode%%:*}
        if [[ $mode == "$XDEBUG_MODE" ]]; then
            known=1
            mitem "$label" "" checked idle
        else
            act_run "Setting Xdebug to ${label}…" "Xdebug is now $label" "" xdebug "$mode"
            mitem "$label" "$REPLY" idle
        fi
        sub+=("$REPLY")
    done
    if (( ! known )); then mitem "$XDEBUG_MODE" "" checked off; sub+=("$MSEP" "$REPLY"); fi
    msub Xdebug "${sub[@]}"
}

# tray menu — the tray icon's menu as JSON (see tray/PROTOCOL.md).
tray_menu() {
    local running problem="" hint items=() sub=() i off=off state=stopped status=Stopped
    TRAY_RUNNING=0
    WSL_ROOT=''

    # Asking for the running containers also shows whether Docker is there.
    # The menu still works when it isn't, so say why rather than fail.
    if ! running=$(services --filter status=running 2>/dev/null) && ! problem=$( (check_docker) 2>&1 >/dev/null ); then
        hint=$(printf '%s\n' "$problem" | sed -n 's/^  Hint: //p' | head -n 1)
        problem=$(printf '%s\n' "$problem" | sed -n 's/^✖ //p' | head -n 1)
        [[ -z $hint ]] || problem+=". $hint"
        state=error status="Can't reach Docker"
    else
        problem=""
        load_env >/dev/null
        load_built_php
        if has_line "$running" nginx; then
            TRAY_RUNNING=1 off="" state=running status="Running, $(count ${#SITE_NAMES[@]} site sites)"
        fi
        if is_wsl && [[ -n ${WSL_DISTRO_NAME:-} ]]; then WSL_ROOT="\\\\wsl.localhost\\$WSL_DISTRO_NAME"; fi
    fi

    act open https://localhost; mitem "Open Dashboard" "$REPLY" bold "$off"; items+=("$REPLY" "$MSEP")
    if [[ $state != error ]]; then
        for (( i = 0; i < ${#SITE_NAMES[@]}; i++ )); do site_menu "$i"; items+=("$REPLY"); done
        if (( ! ${#SITE_NAMES[@]} )); then mitem "No sites yet" "" off; items+=("$REPLY"); fi
        add_site_dialog; mitem "Add Site…" "$REPLY" idle; items+=("$REPLY" "$MSEP")
    fi

    if (( TRAY_RUNNING )); then
        act_run "Stopping Novacore…" "Novacore has stopped" "" down; mitem "Stop Novacore" "$REPLY" idle; items+=("$REPLY")
        act_run "Restarting Novacore…" "Novacore has restarted" "" restart; mitem "Restart Novacore" "$REPLY" idle; items+=("$REPLY")
    else
        act_run "Starting Novacore…" "Novacore is running" "" up; mitem "Start Novacore" "$REPLY" idle; items+=("$REPLY")
    fi

    if [[ $state != error ]]; then
        xdebug_menu; items+=("$REPLY")
        act_console "Novacore · database" db shell; mitem "Database Shell" "$REPLY" "$off"; sub+=("$REPLY")
        act_console "Novacore · logs" logs; mitem "Container Logs" "$REPLY"; sub+=("$REPLY")
        act folder "$SITES_PATH"; mitem "Open Sites Folder" "$REPLY"; sub+=("$REPLY")
        msub Tools "${sub[@]}"; items+=("$REPLY")
    fi

    act tray output; mitem "Show Output…" "$REPLY"; items+=("$REPLY")
    act tray refresh; mitem Refresh "$REPLY" idle; items+=("$REPLY" "$MSEP")
    act tray quit; mitem Quit "$REPLY"; items+=("$REPLY")

    jlist "${items[@]}"; local list=$REPLY
    jpairs state "$state" status "$status" ${problem:+problem "$problem"}
    printf '{"version":1,%s,"items":%s}\n' "$REPLY" "$list"
}

# tray submit FORM FIELD=VALUE... — for the tray icons: run the command a
# dialog from tray_menu stands for, given its answers.
tray_submit() {
    local form=${1:-} kv name="" php="" root="" db=0 drop_db=0 site="" args=()
    shift || true
    for kv in "$@"; do
        case $kv in
            name=*)    name=${kv#*=} ;;
            php=*)     php=${kv#*=} ;;
            root=*)    root=${kv#*=} ;;
            db=*)      db=${kv#*=} ;;
            drop-db=*) drop_db=${kv#*=} ;;
            site=*)    site=${kv#*=} ;;
            *)         fail "Unknown field '$kv'" ;;
        esac
    done
    case $form in
        add-site)
            args=(site add "$name" --php "$php")
            [[ -z $root || $root == Auto-detect ]] || args+=(--root "$root")
            [[ $db == 1 ]] || args+=(--no-db)
            ;;
        remove-site)
            args=(site rm "$site")
            [[ $drop_db != 1 ]] || args+=(--drop-db)
            ;;
        *) fail "Unknown form '$form'" ;;
    esac
    exec "$NOVACORE_ROOT/bin/novacore" "${args[@]}"
}

# Where the running command from a tray icon or the Plasma widget keeps its
# state: $L.log for its output, $L.pid, $L.label and $L.done for the messages
# to show, and $L.exit once done.
tray_state() { echo "${TMPDIR:-/tmp}/novacore-tray-$UID"; }

# tray run LABEL DONE ARGS... — for the tray icons and the Plasma widget: run
# novacore ARGS detached, so it finishes even if they stop or are reinstalled
# meanwhile.
tray_run() {
    (( $# >= 3 )) || fail "Usage: novacore tray run <label> <done> <command...>"
    local L i
    L=$(tray_state)
    if [[ ! -f $L.exit && -f $L.pid ]] && kill -0 "$(<"$L.pid")" 2>/dev/null; then
        fail "Another novacore command from the tray icon is still running"
    fi
    rm -f "$L.exit" "$L.pid"
    printf '%s' "$1" > "$L.label"
    printf '%s' "$2" > "$L.done"
    shift 2
    # shellcheck disable=SC2016
    local script='L=$1; shift; echo $$ > "$L.pid"; "$0" "$@" > "$L.log" 2>&1; echo $? > "$L.exit"'
    if command -v setsid >/dev/null; then
        # WSL ends a wsl.exe call's processes when it exits, unless they're in
        # a session of their own.
        setsid -f bash -c "$script" "$NOVACORE_ROOT/bin/novacore" "$L" "$@" < /dev/null > /dev/null 2>&1
    else
        # macOS has no setsid. The menu bar app's launchd job leaves its
        # children running when it stops (AbandonProcessGroup), so a
        # background job is enough.
        ( bash -c "$script" "$NOVACORE_ROOT/bin/novacore" "$L" "$@" < /dev/null > /dev/null 2>&1 & )
    fi
    # Wait for its PID, so a poll straight after this sees it running.
    for (( i = 0; i < 50; i++ )); do [[ -s $L.pid ]] && return; sleep 0.1; done
}

# tray poll — for the tray icons and the Plasma widget: the command's exit
# code (blank while it runs), "alive" or "dead", its label and done message,
# then its output. They ask every second, so this reads the files itself
# rather than starting a program for each.
tray_poll() {
    local L code="" pid="" label="" done="" alive=dead
    L=$(tray_state)
    {
        read -r code < "$L.exit"
        read -r pid < "$L.pid"
        IFS= read -r label < "$L.label"
        IFS= read -r done < "$L.done"
    } 2>/dev/null || true
    # Check the PID isn't empty: kill -0 "" would signal our own process group.
    if [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null; then alive=alive; fi
    printf '%s\n' "$code" "$alive" "$label" "$done"
    tail -n 200 "$L.log" 2>/dev/null || true
}

# --- Windows tray icon ---

# windows_ps — run the PowerShell script on stdin on Windows. Encoding it saves
# quoting it through WSL's interop, and lets it span lines.
windows_ps() {
    local script
    # Without $ProgressPreference, progress such as "Preparing modules for
    # first use" comes out as CLIXML.
    script=$({ echo '$ProgressPreference = "SilentlyContinue"'; cat; } | iconv -f utf-8 -t utf-16le | base64 -w0)
    powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand "$script" | tr -d '\r'
}

# PowerShell that stops the tray icon if it's running.
TRAY_STOP_PS='
$ErrorActionPreference = "Stop"
$dir = Join-Path ([Environment]::GetFolderPath("LocalApplicationData")) "Novacore"
$lnk = Join-Path ([Environment]::GetFolderPath("Startup")) "Novacore.lnk"
# NovacoreTray.exe, or PowerShell running the script before it hands over.
$running = @(Get-CimInstance Win32_Process -Filter "Name = '"'NovacoreTray.exe'"'") +
    @(Get-CimInstance Win32_Process -Filter "Name = '"'powershell.exe'"'" |
        Where-Object { $_.CommandLine -like "*novacore-tray.ps1*" })
if ($running) {
    $running | Invoke-CimMethod -MethodName Terminate | Out-Null
    # Let its single-instance mutex go before a new one starts.
    Start-Sleep -Milliseconds 500
}
'

# Install the tray icon on Windows: copy the script to %LOCALAPPDATA%\Novacore,
# start it from a shortcut in the Startup folder, and start it now. Run again
# to update it after pulling a new version.
windows_tray_install() {
    header "Installing the tray icon"
    heading "Windows tray icon"
    NC_SCRIPT=$(wslpath -w "$NOVACORE_ROOT/windows/novacore-tray.ps1") \
    NC_DISTRO=$WSL_DISTRO_NAME \
    NC_COMMAND="$NOVACORE_ROOT/bin/novacore" \
    WSLENV=NC_SCRIPT:NC_DISTRO:NC_COMMAND \
    windows_ps <<<"$TRAY_STOP_PS"'
New-Item -ItemType Directory -Force $dir | Out-Null
$ps1 = Join-Path $dir "novacore-tray.ps1"
Copy-Item -LiteralPath $env:NC_SCRIPT -Destination $ps1 -Force
Copy-Item -LiteralPath (Join-Path (Split-Path $env:NC_SCRIPT) "novacore.ico") -Destination $dir -Force

# A headless console, so no window flashes up as PowerShell starts.
$shortcut = (New-Object -ComObject WScript.Shell).CreateShortcut($lnk)
$shortcut.TargetPath = Join-Path $env:WINDIR "System32\conhost.exe"
$shortcut.Arguments = "--headless powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden " +
    "-File `"$ps1`" -Distro `"$env:NC_DISTRO`" -Command `"$env:NC_COMMAND`""
$shortcut.WorkingDirectory = $dir
$shortcut.Description = "Novacore tray icon"
$shortcut.Save()
Start-Process -FilePath $lnk
' || fail "Couldn't install the tray icon"
    result "Installed for the $WSL_DISTRO_NAME distro. It starts when you sign in to Windows"
    complete Installed
    echo
}

windows_tray_uninstall() {
    header "Removing the tray icon"
    heading "Windows tray icon"
    windows_ps <<<"$TRAY_STOP_PS"'
Remove-Item -LiteralPath $lnk -Force -ErrorAction SilentlyContinue
Remove-Item -LiteralPath $dir -Recurse -Force -ErrorAction SilentlyContinue
Remove-Item -LiteralPath "HKCU:\Software\Classes\AppUserModelId\Novacore.Tray" -Recurse -Force -ErrorAction SilentlyContinue
' || fail "Couldn't remove the tray icon"
    result "Removed"
    complete Removed
    echo
}

# --- macOS menu bar icon ---

MAC_TRAY_ID=io.github.jonbp.novacore.tray
MAC_TRAY_APP="$HOME/Applications/Novacore Tray.app"
MAC_TRAY_AGENT="$HOME/Library/LaunchAgents/$MAC_TRAY_ID.plist"
MAC_TRAY_LOG="$HOME/Library/Logs/Novacore/tray.log"

# The hash of the menu bar app's source and icon. The app compares it with the
# one it was built from, to rebuild itself after a git pull.
mac_tray_hash() {
    cat "$NOVACORE_ROOT/macos/NovacoreTray.swift" "$NOVACORE_ROOT/macos/novacore.icns" | shasum -a 256 | cut -d' ' -f1
}

xml_str() {
    local s=${1//&/&amp;}
    s=${s//</&lt;}
    s=${s//>/&gt;}
    printf '%s' "$s"
}

# Build the menu bar app into ~/Applications, start it from a LaunchAgent, and
# start it now. Run again to update it; the app also does that itself when the
# repo's copy changes.
macos_tray_install() {
    header "Installing the menu bar icon"
    heading "macOS menu bar icon"
    xcrun --find swiftc >/dev/null 2>&1 ||
        fail "Building the icon needs the Xcode Command Line Tools" "Run xcode-select --install, then try again"
    command -v docker >/dev/null || warn "docker isn't on your PATH, so the icon won't find it either"

    local tmp app uid domain i
    tmp=$(mktemp -d)
    # shellcheck disable=SC2064
    trap "rm -rf '$tmp'" EXIT
    app="$tmp/Novacore Tray.app"
    mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
    run xcrun swiftc -O -swift-version 5 -o "$app/Contents/MacOS/NovacoreTray" "$NOVACORE_ROOT/macos/NovacoreTray.swift" ||
        fail "Couldn't build the menu bar icon"
    cp "$NOVACORE_ROOT/macos/novacore.icns" "$app/Contents/Resources/"
    cat > "$app/Contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key><string>$MAC_TRAY_ID</string>
    <key>CFBundleName</key><string>Novacore Tray</string>
    <key>CFBundleDisplayName</key><string>Novacore Tray</string>
    <key>CFBundleExecutable</key><string>NovacoreTray</string>
    <key>CFBundleIconFile</key><string>novacore</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$(xml_str "$(version)")</string>
    <key>CFBundleVersion</key><string>1</string>
    <key>LSUIElement</key><true/>
    <key>NSHighResolutionCapable</key><true/>
    <key>NovacoreCommand</key><string>$(xml_str "$NOVACORE_ROOT/bin/novacore")</string>
    <key>NovacoreSourceHash</key><string>$(mac_tray_hash)</string>
</dict>
</plist>
EOF
    # Sign it as a whole, so macOS knows it as one app, e.g. for notifications.
    run codesign --force --sign - "$app" || fail "Couldn't sign the menu bar icon"

    # Stop the running one, then swap in the new one.
    uid=$(id -u)
    domain="gui/$uid"
    launchctl bootout "$domain/$MAC_TRAY_ID" 2>/dev/null || true
    mkdir -p "$(dirname "$MAC_TRAY_APP")" "$(dirname "$MAC_TRAY_AGENT")" "$(dirname "$MAC_TRAY_LOG")"
    rm -rf "$MAC_TRAY_APP"
    mv "$app" "$MAC_TRAY_APP"

    # launchd starts apps with a bare PATH, so give it this one, where docker is.
    cat > "$MAC_TRAY_AGENT" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>$MAC_TRAY_ID</string>
    <key>ProgramArguments</key>
    <array><string>$(xml_str "$MAC_TRAY_APP/Contents/MacOS/NovacoreTray")</string></array>
    <key>RunAtLoad</key><true/>
    <!-- Restart it if it crashes, but not after Quit. -->
    <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
    <!-- Let commands it started finish when it stops, e.g. to update itself. -->
    <key>AbandonProcessGroup</key><true/>
    <key>ProcessType</key><string>Interactive</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>$(xml_str "$PATH")</string>
        <key>LANG</key><string>$(xml_str "${LANG:-en_US.UTF-8}")</string>
    </dict>
    <key>StandardOutPath</key><string>$(xml_str "$MAC_TRAY_LOG")</string>
    <key>StandardErrorPath</key><string>$(xml_str "$MAC_TRAY_LOG")</string>
</dict>
</plist>
EOF
    # Straight after a bootout, launchd can still be tearing the old one down.
    for (( i = 0; i < 20; i++ )); do
        launchctl bootstrap "$domain" "$MAC_TRAY_AGENT" 2>/dev/null && break
        sleep 0.5
    done
    (( i < 20 )) || fail "Couldn't start the menu bar icon" "Try launchctl bootstrap $domain $MAC_TRAY_AGENT"
    result "Installed in ~/Applications. It starts when you log in"
    complete Installed
    echo
}

macos_tray_uninstall() {
    header "Removing the menu bar icon"
    heading "macOS menu bar icon"
    launchctl bootout "gui/$(id -u)/$MAC_TRAY_ID" 2>/dev/null || true
    pkill -x NovacoreTray 2>/dev/null || true
    rm -rf "$MAC_TRAY_APP" "$MAC_TRAY_AGENT" "$(dirname "$MAC_TRAY_LOG")"
    defaults delete "$MAC_TRAY_ID" >/dev/null 2>&1 || true
    result "Removed"
    complete Removed
    echo
}

cmd_tray() {
    case ${1:-} in
        run)    shift; tray_run "$@"; return ;;
        poll)   tray_poll; return ;;
        menu)   tray_menu; return ;;
        submit) shift; tray_submit "$@"; return ;;
    esac
    local os
    if [[ $(uname) == Darwin ]]; then
        os=macos
    elif is_wsl && [[ -n ${WSL_DISTRO_NAME:-} ]]; then
        os=windows
        command -v powershell.exe >/dev/null || fail "Can't find powershell.exe" "Is Windows interop turned on in WSL?"
    else
        fail "The tray icon is for macOS, and Windows with Novacore in WSL" \
            "On KDE Plasma, use the widget in plasmoid/ instead"
    fi
    case ${1:-install} in
        install)   "${os}_tray_install" ;;
        uninstall) "${os}_tray_uninstall" ;;
        *)         fail "Unknown option '$1'" "Usage: novacore tray [install|uninstall]" ;;
    esac
}

usage() {
    cat <<'EOF'
Usage: novacore <command> [options]

Runs local PHP sites on Docker, with nginx, PHP-FPM (7.4 to 8.5) and MariaDB.

Stack:
  up                          Start everything (and apply config changes)
  down                        Stop everything
  restart                     Stop, then start everything
  status [--json]             Show containers and sites
  reload                      Regenerate config from sites.conf and apply it
  logs [service]              Follow container logs (nginx, mariadb, php84, ...)
  build [--all]               Rebuild images (--all builds every PHP version)
  prune [--cache]             Remove images of PHP versions no site uses
  trust                       Trust Novacore's local CA (one-off, uses sudo)
  tray [install|uninstall]    macOS or Windows (WSL): add Novacore to the menu bar or taskbar

Sites:
  site add <name> [--php X.Y] [--root DIR] [--no-db]
                              Serve sites/<name> at https://<name>.localhost
  site rm <name> [--drop-db]  Stop serving a site (its files are kept)
  site list                   List sites
  site info <name>            Show a site's URL, paths and database settings
  errors [site] [--clear]     Follow a site's PHP error log (logs/<site>.log), or all of them
  open [site]                 Open a site (or the dashboard) in your browser

PHP:
  php list                    Show available PHP versions
  php <site> [X.Y]            Show or switch a site's PHP version
  php default [X.Y]           Show or set the default for new sites
  xdebug [on|off|<mode>]      Show or set the Xdebug mode for all PHP versions
  shell [site]                Bash in the site's PHP container
  exec <site> <cmd...>        Run a command there, e.g. composer install, wp plugin list

Databases:
  db list                     List databases
  db create|drop <name>       Create or drop a database
  db import <name> <file>     Import a .sql or .sql.gz file
  db export <name> [file]     Dump to a .sql.gz file (or .sql)
  db shell [name]             MariaDB console

Options:
  -h, --help                  Show this help
  -V, --version               Show the version

EOF
}

main() {
    local cmd=${1:-help}
    shift || true
    case $cmd in
        help|-h|--help)       usage; return ;;
        version|-V|--version) echo "Novacore $(version)"; return ;;
        tray)                 cmd_tray "$@"; return ;;
    esac

    check_docker
    load_env

    case $cmd in
        up|start)     cmd_up ;;
        down|stop)    cmd_down ;;
        restart)      cmd_up --restart ;;
        status|ps)    cmd_status "$@" ;;
        reload)       cmd_reload ;;
        logs)         cmd_logs "$@" ;;
        errors)       cmd_errors "$@" ;;
        build)        cmd_build "$@" ;;
        prune)        cmd_prune "$@" ;;
        trust)        cmd_trust ;;
        site)         cmd_site "$@" ;;
        sites)        site_list ;;
        open)         cmd_open "$@" ;;
        php)          cmd_php "$@" ;;
        xdebug)       cmd_xdebug "$@" ;;
        shell)        cmd_shell "$@" ;;
        exec)         cmd_exec "$@" ;;
        composer|wp)
            [[ -n ${1:-} ]] || fail "Which site?" "Usage: novacore $cmd <site> <args...>"
            cmd_exec "$1" "$cmd" "${@:2}"
            ;;
        db)           cmd_db "$@" ;;
        *)            fail "Unknown command '$cmd'" "Run novacore help to see the commands" ;;
    esac
}

main "$@"
