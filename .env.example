# Novacore configuration. Copied to .env on first run; apply changes with `novacore up`.

# Sites are served at https://<name>.<NOVACORE_TLD>. "localhost" needs no DNS or
# hosts-file changes: browsers and systemd-resolved send *.localhost to 127.0.0.1.
NOVACORE_TLD=localhost

# Where site folders live: an absolute path, or relative to this directory.
SITES_DIR=./sites

# PHP version for new sites. Supported: 7.4 8.0 8.1 8.2 8.3 8.4 8.5
DEFAULT_PHP=8.4

# off, debug, develop, profile, coverage or trace. Separate with commas to combine.
XDEBUG_MODE=develop,debug

# Host address and ports for the web and database servers.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
DB_PORT=3306

# Credentials only take effect when the database volume is first created.
DB_ROOT_PASSWORD=root
DB_USER=novacore
DB_PASSWORD=novacore

# Your host user and group IDs, so PHP writes files you own. Filled in automatically.
NOVACORE_UID=1000
NOVACORE_GID=1000
